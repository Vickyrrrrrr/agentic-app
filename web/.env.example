# Safe client-side Supabase values.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me

# Renderer talks to the local AgentIC backend in desktop builds.
VITE_DESKTOP_API_BASE_URL=http://localhost:7860

# Optional: lets Electron pass the production license server URL to the local backend.
# This is not a secret.
VITE_AGENTIC_LICENSE_SERVER_URL=https://api.buildstack.live

# Do not put Lemon Squeezy API keys, webhook secrets, Supabase service-role keys,
# or entitlement private keys in this file.
